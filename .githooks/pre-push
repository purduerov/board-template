#!/usr/bin/env bash
# Pre-push hook for board-template:
# Whenever changes are pushed to board-template, automatically run the central sync script
# to propagate launchers, hooks, and workflows to all organization board repositories!

echo "🚀 Auto-syncing board-template updates to all organization board repositories..."
SCRIPT_DIR="$(dirname "$0")"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -f "$REPO_ROOT/../pcb-devops/scripts/sync_template_to_all.ps1" ]; then
    powershell.exe -File "$REPO_ROOT/../pcb-devops/scripts/sync_template_to_all.ps1" || true
elif [ -f "$REPO_ROOT/../pcb-devops/scripts/sync_template_to_all.sh" ]; then
    bash "$REPO_ROOT/../pcb-devops/scripts/sync_template_to_all.sh" || true
fi
