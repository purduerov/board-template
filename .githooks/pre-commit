#!/usr/bin/env bash
# Pre-commit hook to verify KiCad volatile metadata clean filters, auto-update submodules, and validate symbols.

# 1. Auto-fetch latest Purdue ROV central library submodule before commit
if [ -d "libs/purdue-rov-kicad-lib" ]; then
    echo "🔄 Auto-fetching latest Purdue ROV component library before commit..."
    git -C libs/purdue-rov-kicad-lib pull origin master --quiet || true
    git add libs/purdue-rov-kicad-lib || true
fi

# 2. Verify symbol library compliance if symbol files are modified
if [ -f "libs/purdue-rov-kicad-lib/scripts/linter_validator.py" ]; then
    python3 libs/purdue-rov-kicad-lib/scripts/linter_validator.py libs/purdue-rov-kicad-lib/Symbols/*.kicad_sym || true
fi

# 3. Verify and configure KiCad clean/smudge filters if missing
SCH_CLEAN=$(git config --get filter.kicad_sch_cleaner.clean || true)

if [ -z "$SCH_CLEAN" ]; then
    echo "⚠️  WARNING: KiCad Git clean filters are not configured on this machine!"
    echo "Running automatic filter configuration..."
    
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
    
    if [ -f "$REPO_ROOT/scripts/setup_git_filters.sh" ]; then
        bash "$REPO_ROOT/scripts/setup_git_filters.sh"
    elif [ -f "$REPO_ROOT/setup_git_filters.sh" ]; then
        bash "$REPO_ROOT/setup_git_filters.sh"
    elif [ -f "$REPO_ROOT/scripts/setup_git_filters.ps1" ]; then
        powershell.exe -File "$REPO_ROOT/scripts/setup_git_filters.ps1"
    fi

    
    echo "Configured filters! Re-staging files to apply the cleaning..."
    if git diff --cached --name-only --diff-filter=d '*.kicad_sch' '*.kicad_pcb' '*.kicad_pro' | grep -q .; then
        git diff --cached --name-only -z --diff-filter=d '*.kicad_sch' '*.kicad_pcb' '*.kicad_pro' | xargs -0 git add
    fi
    echo "Re-staging complete."
fi
